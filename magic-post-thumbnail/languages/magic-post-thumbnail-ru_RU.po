msgstr "Логотип полосы"

msgid "Select logo"
msgstr "Выбрать логотип"

msgid "This bank does not support keyword preview. During generation it uses the first image already in the post."
msgstr "Этот банк не поддерживает предпросмотр по ключевому слову. При генерации берётся первое изображение записи."

msgid "Choose a default image in the settings on the left."
msgstr "Выберите изображение по умолчанию в настройках слева."

msgid "Generate"
msgstr "Создать"

msgid "Regenerate"
msgstr "Создать заново"

msgid "Generating…"
msgstr "Создание…"

msgid "Generation failed"
msgstr "Ошибка создания"

msgid "Open in Media Library"
msgstr "Открыть в медиатеке"

msgid "Ready to generate"
msgstr "Готово к созданию"

msgid "Needs attention"
msgstr "Требует внимания"

msgid "Generate a test image"
msgstr "Создать тестовое изображение"

msgid "Creates a draft post so your live articles are left untouched."
msgstr "Создаёт черновик, опубликованные записи не изменяются."

msgid "This test will call a generative AI service and consume tokens. Continue?"
msgstr "Этот тест вызовет сервис ИИ и потратит токены. Продолжить?"

msgid "Open the test draft"
msgstr "Открыть тестовый черновик"

msgid "Magic Post Thumbnail — test"
msgstr "Magic Post Thumbnail — test"

msgid "This draft was created to verify image generation. You can delete it."
msgstr "Этот черновик создан для проверки генерации изображений. Его можно удалить."

msgid "%s requires the Pro version"
msgstr "%s требует версию Pro"

msgid "%s: no API key"
msgstr "%s: нет ключа API"

msgid "%s: key failed"
msgstr "%s: ключ недействителен"

msgid "%s: key not tested yet"
msgstr "%s: ключ ещё не проверен"

msgid "Add a bank to the chain first."
msgstr "Сначала добавьте банк в цепочку."

msgid "All banks in the chain are ready."
msgstr "Все банки в цепочке готовы."

msgid "No image placement configured."
msgstr "Место изображения не настроено."

msgid "Title bar will be drawn on generated images."
msgstr "Полоса заголовка будет нарисована на созданных изображениях."

msgid "PHP GD is missing; the overlay cannot be drawn."
msgstr "Нет PHP GD; полосу нельзя нарисовать."

msgid "Overlay is on but this server cannot draw TrueType text. Accents may break."
msgstr "Полоса включена, но сервер не может рисовать текст TrueType. Диакритика может пропасть."

