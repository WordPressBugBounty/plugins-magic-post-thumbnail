msgstr "%s: ключ ще не перевірено"

msgid "Add a bank to the chain first."
msgstr "Спочатку додайте банк до ланцюжка."

msgid "All banks in the chain are ready."
msgstr "Усі банки в ланцюжку готові."

msgid "No image placement configured."
msgstr "Місце зображення не налаштовано."

msgid "Title bar will be drawn on generated images."
msgstr "Смугу заголовка буде намальовано на згенерованих зображеннях."

msgid "PHP GD is missing; the overlay cannot be drawn."
msgstr "Немає PHP GD; смугу неможливо намалювати."

msgid "Overlay is on but this server cannot draw TrueType text. Accents may break."
msgstr "Смуга ввімкнена, але сервер не може малювати текст TrueType. Діакритика може зникнути."

